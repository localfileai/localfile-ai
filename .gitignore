# --- 프론트엔드 ---
node_modules
dist
dist-electron
release
.vite

# --- 백엔드 ---
backend/.venv
__pycache__/
*.py[cod]

# 실행 산출물. 명령으로 다시 만들 수 있으므로 커밋하지 않는다.
#   dataset/   -> npm run dataset  (약 2분)
#   chroma_db/ -> npm run index    (GPU 2분 / CPU 50분)
backend/chroma_db/
backend/dataset/
backend/dataset_smoke/
