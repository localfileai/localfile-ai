# 저장소 안에서는 항상 LF. 체크아웃할 때만 OS에 맞춥니다.
# Windows(BE1·BE2)와 macOS를 섞어 쓰므로 이게 없으면 줄바꿈만 바뀐 diff가
# PR마다 올라와 실제 변경을 덮습니다.
* text=auto eol=lf

# Windows 전용 스크립트는 CRLF여야 합니다.
*.ps1   text eol=crlf
*.bat   text eol=crlf
*.cmd   text eol=crlf

# 바이너리 — diff 시도하지 않습니다.
*.png   binary
*.jpg   binary
*.gif   binary
*.ico   binary
*.pdf   binary
*.docx  binary
*.pptx  binary
*.woff  binary
*.woff2 binary

# 생성물 — GitHub 언어 통계와 diff에서 접습니다.
packages/contracts/*.ts  linguist-generated=true
*.lock                   linguist-generated=true -diff
package-lock.json        linguist-generated=true -diff
